# Server-only. Never prefix these with NEXT_PUBLIC_.
# The browser talks to same-origin /api/*; secrets stay on the server.

# Anthropic API — judgement stages. If unset, reasoners fall back to
# deterministic rules and the UI labels DEMO MODE · SIMULATED REASONING.
ANTHROPIC_API_KEY=

# Supabase project. If unset, the in-memory store is used (demo persistence).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key — server-only (lib/supabaseAdmin.ts). Never expose to
# the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signed inbound webhook for prove@elestar.ai (POST /api/inbound).
# Send the secret as `x-elestar-webhook-secret` or `Authorization: Bearer`.
# If unset, /api/inbound returns 503 and live mail is not accepted.
INBOUND_WEBHOOK_SECRET=

# Production hardening. Leave unset for local/eval (defaults shown).
# ELESTAR_ALLOW_SIMULATION=true
# ELESTAR_REQUIRE_PERSISTENCE=false
# ELESTAR_LIVE_RESEARCH=false
